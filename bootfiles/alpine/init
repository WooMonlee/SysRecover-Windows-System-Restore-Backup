#!/bin/sh
# SysRecover rescue init —— Alpine linux-lts 底座（PID 1）
#
# 与旧 BG-Rescue 底座的区别：
#   * 内核自带全套存储模块（ahci/nvme/mpt3sas/mptspi/megaraid_sas/virtio_blk…），
#     启动时 modprobe 加载即可，彻底解决"服务器/VMware SCSI 认不到盘"。
#   * 控制台驱动内建（SERIAL_8250_CONSOLE / FRAMEBUFFER_CONSOLE）→ 输出可见。
#   * devtmpfs 由内核自动挂载，无需 mdev。
#   * 自写 /init，无 rcS/inittab 交互脚本，启动无任何选择提示。
#
# 消息全 ASCII（部分控制台无中文字库）。

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# 先把 busybox applet 全装上（/bin/sh 已在镜像里预置为 → busybox 的符号链接，
# 否则内核执行本脚本的 #!/bin/sh 会失败 → "No working init found"）。
/bin/busybox --install -s /bin 2>/dev/null
# busybox 自带的简化 blkid 会遮蔽 /sbin/blkid(util-linux)，后者的
# `-s TYPE -o value` 才是我们要的 → 删掉 busybox 版
rm -f /bin/blkid

# 必须先建挂载点再挂（initramfs 根里默认没有 /proc /sys 目录，否则 mount 失败）
mkdir -p /proc /sys /dev /tmp /mnt
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null

LOG=/tmp/zjrestore.log
say(){ echo "SR: $*"; echo "$(date '+%F %T') $*" >> "$LOG"; }

say "SysRecover rescue (kernel $(uname -r))"

# ── 加载存储 / 文件系统模块（覆盖 SATA/AHCI、NVMe、各厂商 HBA、虚拟化、USB）──
# 注意：不要跑 depmod（busybox depmod 可能写坏 modules.dep）；直接用镜像里
# 预置的 modules.dep 让 modprobe 解析依赖。先显式加载几个底层依赖模块，
# 避免 sd_mod/usbcore 因缺符号而加载失败。
ldmod(){
    # nvme-core 显式带 io_timeout=1：虚拟 NVMe（VMware/QEMU）偶发"完成中断
    # 丢失"，默认要等满 30s 才轮询 CQ（每 N% 卡 30s，见 PIT-055）。用 modprobe
    # 传参保证在控制器 probe 前就生效（比仅 cmdline/sysfs 更可靠）。
    # 单位=秒，最小 1（内核参数是整数秒），无法设 500ms。
    case "$1" in
        nvme-core|nvme_core) set -- "$1" io_timeout=1 ;;
    esac
    _n="$1"; _n=${_n%.ko}; _n=${_n%.ko.gz}; _n=$(echo "$_n" | tr '_' '-')
    _e=$(modprobe "$@" 2>&1) && return 0
    # modprobe 失败要分情况，**不能笼统当成"ok"**（问题清单 H-01）：
    #   a) 名字不在模块表里，但 `modules.builtin` 里有 → **内建**，正常；
    #   b) 名字不在模块表里，`modules.builtin` 里也没有 → **真缺失**：该功能不可用，
    #      必须显式 WARN（否则"驱动没加载"会被误当成"一切正常"，排查时是黑盒）；
    #   c) "No such device" → 模块在，但**机器上没有对应硬件**（`hv_vmbus`/`xen-blkfront`
    #      只在对应虚拟化下才有；普通机器加载必然 ENODEV）→ 正常，降级成信息。
    case "$_e" in
        *"not found"*)
            if grep -q "/$_n\.ko" "/lib/modules/$(uname -r)/modules.builtin" 2>/dev/null; then
                say "  $_n: builtin (ok)"
            else
                say "  $_n: WARN not bundled (feature unavailable)"
            fi ;;
        *[Nn]o" such device"*)
            say "  $_n: not applicable (no such device)" ;;
        *)
            say "modprobe $* FAIL: $_e" ;;
    esac
}
# 帧缓冲：**Debian 底座不需要 simpledrm**（那是 Alpine 内核的问题——它 SYSFB_SIMPLEFB=y
# 会顶掉内建 efifb；Debian 的 simplefb 内建、直接接管 GOP 帧缓冲 → 见 PIT-061 / PIT-079）。
for m in usb-common scsi_mod crc32c_generic libcrc32c nls_cp437 nls_iso8859-1 nls_ascii nls_base; do
    ldmod "$m"
done
# 依赖在前、被依赖者在后；跑两轮以防某轮顺序导致依赖未就绪而失败。
# 名单按"市面覆盖率"整理，与 WinPE 厂商驱动包（Dell/HP WinPE Driver Pack）的
# 存储驱动集对齐，并映射到 Linux 驱动名：
#   Intel VMD/VROC(iaStorVD)      -> vmd (+nvme)      ← WinPE "找不到盘"第一大原因
#   Intel RST client(iaStorAC)    -> ahci
#   Intel RSTe/VROC C 系          -> isci / megaraid_sas / ahci
#   AMD RAIDXpert2(rcraid)        -> ahci（Linux 直接见物理盘）
#   Broadcom MegaRAID/HBA mpi3    -> megaraid_sas / mpt3sas
#   Microchip SmartPQI            -> smartpqi
#   通用 NVMe / SATA / IDE        -> nvme / ahci / ata_piix / ata_generic
#   UFS / eMMC                    -> ufs / mmc + sdhci
#   虚拟化                        -> virtio_blk / virtio_scsi / vmw_pvscsi / hv_storvsc / xen-blkfront
# 注：`pcieport`/`nvme-common`/`linear`（dm-linear 已并入 dm-mod）这几个名字在本内核里
#     既非模块也非内建 —— 删掉，别让它们刷 WARN（问题清单 M-02）。
for _pass in 1 2; do
for m in \
    scsi_mod libata libahci ata_piix ata_generic ahci \
    vmd \
    nvme-core nvme \
    libsas mptbase mptscsih mpt3sas mptspi mptsas \
    megaraid_mm megaraid_mbox megaraid megaraid_sas \
    smartpqi aacraid hpsa arcmsr pm80xx mvsas isci \
    virtio virtio_ring virtio_pci virtio_blk virtio_scsi vmw_pvscsi \
    hv_vmbus hv_storvsc pci-hyperv xen-blkfront \
    ufshcd-core ufshcd-pci mmc_core sdhci sdhci-pci sdhci-acpi \
    dm-mod raid0 raid1 raid10 dm-multipath \
    usbcore xhci-hcd xhci-pci ehci-hcd ehci-pci ohci-hcd ohci-pci uhci-hcd \
    usbhid hid hid-generic atkbd \
    usb-storage uas sd_mod sg sr_mod ses \
    ntfs3 fuse vfat fat msdos exfat nls_cp936 nls_utf8 ; do
    ldmod "$m"
done
done

say "modules loaded; waiting for disks"
sleep 3
say "nvme dmesg: $(dmesg 2>/dev/null | grep -iE 'nvme|pcie' | tail -n 5 | tr '\n' '|')"

# NVMe I/O 超时：默认 30s。虚拟 NVMe（VMware/QEMU）偶发"完成中断丢失"——
# 设备其实已把完成项写进 CQ，但驱动没收到中断 → 要等满 io_timeout（30s）才
# 去轮询 CQ，表现为每 N% 卡满 30s（dmesg: `... timeout, completion polled`）。
# 降到 1s（内核参数是整数秒，最小 1，设不了 500ms）：轮询几乎总能立刻在 CQ
# 找到完成项，卡顿 30s→1s。见 PIT-055。
for _p in /sys/module/nvme_core/parameters/io_timeout /sys/module/nvme/parameters/io_timeout; do
    if [ -w "$_p" ]; then
        _old=$(cat "$_p" 2>/dev/null)
        echo 1 > "$_p" 2>/dev/null && say "nvme io_timeout: ${_old}s -> $(cat "$_p" 2>/dev/null)s"
        break
    fi
done

# ── 设备枚举（只取分区）──
list_parts(){
    for _p in /sys/class/block/*; do
        [ -f "$_p/partition" ] || continue
        echo "/dev/$(basename "$_p")"
    done
}
say "block devs: $(ls /sys/class/block 2>/dev/null | tr '\n' ' ')"

# ── 兜底：一个分区都没枚举到 → 名单可能漏了驱动，全量 modprobe 两轮再扫 ──
# 这是为了"通用兼容"而设的保险：宁可慢一次，也不要因为漏一个驱动名而
# 在客户机器上认不到盘。只在失败路径执行（正常机器不会付这个时间）。
if [ -z "$(list_parts)" ]; then
    say "no partitions seen -> sweeping ALL modules (may take a while)"
    _n=0
    for _pass in 1 2; do
        for _k in $(find /lib/modules/"$(uname -r)"/kernel -type f \( -name '*.ko.gz' -o -name '*.ko' \) | sort); do
            _b=$(basename "$_k"); _b=${_b%.ko.gz}; _b=${_b%.ko}
            modprobe "$_b" 2>/dev/null
            _n=$((_n + 1))
        done
        say "sweep pass $_pass done (loaded $_n module names total)"
        sleep 1
    done
    sleep 3
    say "after sweep, block devs: $(ls /sys/class/block 2>/dev/null | tr '\n' ' ')"
fi
say "partitions: $(list_parts | tr '\n' ' ')"

ZJ_M=/tmp/zj_m
mkdir -p "$ZJ_M"

mnt_dev(){
    _dev="$1"; _mnt="$2"
    : > /tmp/zjmnt.err
    _fs=$(blkid -s TYPE -o value "$_dev" 2>/dev/null)
    echo "$_fs" > /tmp/zjmnt.fs
    case "$_fs" in
        ntfs)
            mount -t ntfs3 "$_dev" "$_mnt" 2>>/tmp/zjmnt.err && return 0
            ntfs-3g -o remove_hiberfile "$_dev" "$_mnt" 2>>/tmp/zjmnt.err && return 0
            ntfs-3g -o force "$_dev" "$_mnt" 2>>/tmp/zjmnt.err && return 0
            ;;
        vfat|fat|fat32)
            mount -t vfat "$_dev" "$_mnt" 2>>/tmp/zjmnt.err && return 0
            ;;
        exfat)
            mount -t exfat "$_dev" "$_mnt" 2>>/tmp/zjmnt.err && return 0
            ;;
        ext4|ext3|ext2|xfs|btrfs)
            mount "$_dev" "$_mnt" 2>>/tmp/zjmnt.err && return 0
            ;;
        *)
            mount "$_dev" "$_mnt" 2>>/tmp/zjmnt.err && return 0
            ;;
    esac
    return 1
}

# ── 1) 找 _zjresy*.log（主契约，位于目标分区根）──
found_log=""
TARGET_DEV=""
# 扫各分区找任务日志（主契约：_zjresy*.log 在目标分区根）→ 设 found_log / TARGET_DEV。
# 抽成函数，便于"全量兜底扫模块后再找一遍"（见 2b）。
scan_for_log(){
    found_log=""; TARGET_DEV=""
    for _d in $(list_parts); do
        [ -b "$_d" ] || continue
        mkdir -p "$ZJ_M"
        if mnt_dev "$_d" "$ZJ_M"; then
            _hit=""
            for _f in "$ZJ_M"/_zjresy*.log; do
                [ -f "$_f" ] || continue
                cp "$_f" /tmp/ 2>/dev/null
                found_log="$_f"; TARGET_DEV="$_d"; _hit=1
                say "found log: $_f (dev=$_d)"
                [ -f "$ZJ_M/restore-task.conf" ] && cp "$ZJ_M/restore-task.conf" /tmp/ 2>/dev/null
            done
            [ -z "$_hit" ] && say "mounted $_d (no log)"
            umount "$ZJ_M" 2>/dev/null
            [ -n "$found_log" ] && break
        else
            say "mount FAILED $_d (fs=$(cat /tmp/zjmnt.fs 2>/dev/null)): $(cat /tmp/zjmnt.err 2>/dev/null | tr '\n' ' ')"
        fi
    done
    [ -n "$found_log" ] || say "no _zjresy*.log found"
}
scan_for_log

# ── 2) conf 未找到 → 各分区搜索（软件目录可能在子目录）──
if [ ! -f /tmp/restore-task.conf ]; then
    for _d in $(list_parts); do
        [ -b "$_d" ] || continue
        mkdir -p "$ZJ_M"
        if mnt_dev "$_d" "$ZJ_M"; then
            _c=$(find "$ZJ_M" -maxdepth 4 -name restore-task.conf 2>/dev/null | head -1)
            [ -n "$_c" ] && { cp "$_c" /tmp/restore-task.conf 2>/dev/null; say "found conf: $_c"; }
            umount "$ZJ_M" 2>/dev/null
            [ -f /tmp/restore-task.conf ] && break
        fi
    done
fi

# ── 2b) 全量兜底：扫过所有分区都没找到任务日志 → 磁盘可能压根没被认出来 ──
# 为什么不能只在"零分区"时兜底（问题清单 H-02）：`usb-storage`/`uas` 在主名单里，
# 只要插着 U 盘 `list_parts` 就非空 → 旧条件永远不触发 → 系统盘若因驱动不在名单
# （典型：Hyper-V `hv_storvsc`）而不可见，就会一直找不到目标。这里改成"找不到任务"
# 即全量 modprobe 再扫一遍，把"名单漏了驱动"这条路兜住。
# 代价：手动从常驻菜单进救援（无任务）时也会多花 ~30-45s 扫一遍 —— 可接受（救援本就低频）。
if [ -z "$found_log" ]; then
    say "no task log -> sweeping ALL modules, then rescan"
    for _pass in 1 2; do
        for _k in $(find /lib/modules/"$(uname -r)"/kernel -type f \( -name '*.ko.gz' -o -name '*.ko' \) | sort); do
            _b=$(basename "$_k"); _b=${_b%.ko.gz}; _b=${_b%.ko}
            modprobe "$_b" 2>/dev/null
        done
        sleep 1
    done
    sleep 3
    say "after sweep, block devs: $(ls /sys/class/block 2>/dev/null | tr '\n' ' ')"
    scan_for_log
fi

# ── 2c) 引导补全文件（Windows 侧生成到 <恢复目录>\bootfix\：\bootmgr + \Boot\BCD）──
# 拷到 /tmp/bootfix/（约几 MB），Linux 侧稍后直接 cp 进目标分区。
# 注意：**不能用 wimlib apply** —— wimlib 的 NTFS 卷模式遇到已存在文件会报
# "File exists" → rc=46 (WIMLIB_ERR_NTFS_3G)，而镜像里通常已有 \bootmgr。
if [ ! -f /tmp/bootfix/bootmgr ]; then
    for _d in $(list_parts); do
        [ -b "$_d" ] || continue
        mkdir -p "$ZJ_M"
        if mnt_dev "$_d" "$ZJ_M"; then
            _bf=$(find "$ZJ_M" -maxdepth 4 -type f -path "*bootfix/bootmgr" 2>/dev/null | head -1)
            if [ -n "$_bf" ]; then
                mkdir -p /tmp/bootfix
                cp -r "$(dirname "$_bf")"/* /tmp/bootfix/ 2>/dev/null
                say "found bootfix dir: $(dirname "$_bf")"
            fi
            umount "$ZJ_M" 2>/dev/null
            [ -f /tmp/bootfix/bootmgr ] && break
        fi
    done
fi
[ -f /tmp/bootfix/bootmgr ] || say "warn: no bootfix files (BIOS boot files may be missing)"

# ── 2c) 引导期日志（PIT-059）──
# 把引导阶段（模块加载/分区扫描/找任务）的日志写一份到**目标分区根目录**：
#   · 脚本一旦跑起来会删掉它，并把后续日志写到软件目录；
#   · 若它还留在目标根目录，说明引导阶段就没走完 —— 让用户把该文件发回即可排错。
#   （新布局下救援文件也在目标分区，成功还原会把目标格式化，它自然消失。）
if [ -n "$TARGET_DEV" ] && [ -b "$TARGET_DEV" ]; then
    mkdir -p /tmp/zj_bl
    if mnt_dev "$TARGET_DEV" /tmp/zj_bl; then
        cp "$LOG" /tmp/zj_bl/zjrestore-boot.log 2>/dev/null \
            && say "boot-phase log -> target root"
        sync
        umount /tmp/zj_bl 2>/dev/null
    fi
fi

# ── 3) 执行还原（有日志或 conf 即可）──
# 不 exec：脚本若中途失败，落到 shell 便于排查，也避免 PID1 退出触发 panic。
if [ -x /zjrestore-lite.sh ] && { [ -n "$found_log" ] || [ -f /tmp/restore-task.conf ]; }; then
    say "run restore: target=${TARGET_DEV:-<from offset>}"
    /bin/sh /zjrestore-lite.sh "$TARGET_DEV"
    say "restore script returned (rc=$?)"
fi

say "no restore task -> shell"
exec /bin/sh
