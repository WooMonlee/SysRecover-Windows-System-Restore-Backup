<?xml version="1.0" encoding="utf-8"?>
<!-- 「程序已在运行」三选对话框（单实例互斥命中时弹出，见 src/gui/instance_dlg.cpp）。
     尺寸 460x176，无系统外框 + 圆角（同 main.xml，由 SetWindowRgn 裁）。
     坐标同 main.xml：嵌套 inset 后 Content.m_rcItem = (2,2,...)，XML 坐标 +2 = 屏幕坐标。
     三个按钮横排：默认项「使用之前的程序」用 accent 蓝底白字，另两个白底灰边。 -->
<Window size="460,176" caption="0,0,0,44" roundcorner="24,24" mininfo="460,176">
  <Font id="1" name="Microsoft YaHei UI" size="14" />
  <VerticalLayout bkcolor="#FFEEF1F6" inset="1,1,1,1">
    <VerticalLayout name="Panel" bkcolor="#FFFFFFFF" bordersize="1" bordercolor="#FFE1E7EF" borderround="24,24" inset="1,1,1,1">
      <VerticalLayout name="Content">
        <Control float="true" pos="0,0,456,44" bkcolor="#FFF7F9FC" />
        <SkinLabel name="DlgTitle" float="true" pos="22,12,320,38" text="程序已在运行" fontsize="15" bold="true" color="#FF1B2432" />
        <WinBtn name="DlgClose" float="true" pos="412,2,454,42" glyph="close" />
        <SkinLabel name="DlgMsg" float="true" pos="22,56,434,80" text="「知鉴一键还原」已经打开，请选择要使用哪一个：" fontsize="13" color="#FF5F6C80" />
        <SkinButton name="BtnPrev" float="true" pos="22,100,166,138" text="使用之前的程序" fontsize="14" bkcolor="#FF2B5CE0" bordercolor="#FF2B5CE0" borderround="14,14" textcolor="#FFFFFFFF" />
        <SkinButton name="BtnCur"  float="true" pos="176,100,320,138" text="使用现在新程序" fontsize="14" bkcolor="#FFFFFFFF" bordercolor="#FFE4E8EF" borderround="14,14" textcolor="#FF1B2432" />
        <SkinButton name="BtnQuit" float="true" pos="330,100,434,138" text="退出" fontsize="14" bkcolor="#FFFFFFFF" bordercolor="#FFE4E8EF" borderround="14,14" textcolor="#FF1B2432" />
      </VerticalLayout>
    </VerticalLayout>
  </VerticalLayout>
</Window>
